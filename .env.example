# Local PostgreSQL (Docker Compose)
POSTGRES_USER="user"
POSTGRES_PASSWORD="change-me-local-password"
POSTGRES_DB="mdd_db"
POSTGRES_PORT="5432"

# Keep credentials and port consistent with the values above.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=SCHEMA
DATABASE_URL="postgresql://user:change-me-local-password@localhost:5432/mdd_db?schema=public"

# Auth.js configuration (NextAuth v5)
AUTH_SECRET="your-secret-key-here-change-in-production"
AUTH_URL="http://localhost:3000"
